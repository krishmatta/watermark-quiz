{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watermark-quiz-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATS",
      "id": "REPLACED_AT_DEPLOY"
    }
  ]
}
